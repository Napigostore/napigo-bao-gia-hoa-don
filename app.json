{
  "expo": {
    "name": "Quoivo: Báo giá & Hóa đơn",
    "slug": "napigo-quote-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "napigoquote",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.napigo.baogiahoadon",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Chọn logo và chữ ký để in trên báo giá và phiếu thu."
        }
      ]
    ]
  }
}
